{
  "name": "study-hall",
  "packageManager": "pnpm@8.14.1",
  "engines": {
    "node": "22.x"
  },
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:op": "concurrently \"op run --env-file=.env.1password -- pnpm dev:api\" \"pnpm dev:web\"",
    "start": "pnpm --filter api start",
    "judge-eval": "pnpm --filter api judge-eval",
    "judge-eval:op": "op run --env-file=.env.1password -- pnpm --filter api judge-eval",
    "lint": "pnpm --filter web lint && pnpm --filter api lint",
    "typecheck": "pnpm --filter api typecheck && pnpm --filter web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix --config apps/web/eslint.config.js",
      "prettier --write"
    ],
    "apps/api/**/*.ts": [
      "eslint --fix --config apps/api/eslint.config.js",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}

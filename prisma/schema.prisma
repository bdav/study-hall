generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum RecallGrade {
  MISSED
  PARTIALLY_CORRECT
  GOOD
  NAILED
}

enum CardLifecycleState {
  NEW
  LEARNING
  STABLE
  RETIRED
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum StudySessionItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum SessionType {
  QUICK
  STANDARD
  DEEP
}

enum StudyMode {
  STUDY
  DRILL_WEAKEST
  CRAM
}

enum GradingMethod {
  DETERMINISTIC
  SEMANTIC
  LLM
  REFINED_VARIANT
}

enum AiPurpose {
  SYLLABUS_GENERATION
  LESSON_GENERATION
}

enum ExerciseType {
  SHORT_ANSWER
  FILL_IN_THE_BLANK
  FREE_FORM_EXPLANATION
}

enum ExerciseEvaluation {
  CORRECT
  INCORRECT
}

enum EvaluationMethod {
  DETERMINISTIC
}

// --- Models ---

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  decks         Deck[]
  studySessions StudySession[]
  sessions      Session[]
  cardProgress  CardProgress[]
  courses       Course[]
  aiUsage       AiUsage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deck {
  id            String         @id @default(cuid())
  userId        String
  // Set on a Course Deck. The deck outlives its course (ADR-0003).
  courseId      String?        @unique
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cards         Card[]
  studySessions StudySession[]

  @@index([userId])
}

model Card {
  id               String             @id @default(cuid())
  deckId           String
  front            String
  position         Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deck             Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  canonicalAnswers CanonicalAnswer[]
  attempts         CardAttempt[]
  progress         CardProgress[]
  sessionItems     StudySessionItem[]

  @@index([deckId])
  @@index([deckId, position])
}

model CanonicalAnswer {
  id               String            @id @default(cuid())
  cardId           String
  text             String
  normalizedText   String?
  isPrimary        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  card             Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  acceptedVariants AcceptedVariant[]

  @@unique([cardId, text])
  @@index([cardId])
}

model AcceptedVariant {
  id                String          @id @default(cuid())
  canonicalAnswerId String
  text              String
  normalizedText    String?
  createdAt         DateTime        @default(now())
  canonicalAnswer   CanonicalAnswer @relation(fields: [canonicalAnswerId], references: [id], onDelete: Cascade)

  @@unique([canonicalAnswerId, text])
  @@index([canonicalAnswerId])
}

model CardProgress {
  id               String             @id @default(cuid())
  userId           String
  cardId           String
  deckId           String
  lifecycleState   CardLifecycleState @default(NEW)
  masteryScore     Int                @default(0)
  dueAt            DateTime?
  lastReviewedAt   DateTime?
  lastIntervalDays Float?
  lapseCount       Int                @default(0)
  // When this progress last started over from NEW: its creation or a card
  // edit reset (ADR-0004). Only attempts since then count toward stats.
  resetAt          DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, deckId, lifecycleState, dueAt])
  @@index([userId, deckId, lifecycleState, masteryScore])
  @@index([userId, deckId, dueAt])
}

model StudySession {
  id          String             @id @default(cuid())
  userId      String
  deckId      String
  status      StudySessionStatus @default(ACTIVE)
  sessionType SessionType
  studyMode   StudyMode          @default(STUDY)
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck        Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  items       StudySessionItem[]
  attempts    CardAttempt[]

  @@index([userId])
  @@index([deckId])
  @@index([userId, deckId, status])
}

model StudySessionItem {
  id             String                 @id @default(cuid())
  studySessionId String
  cardId         String
  position       Int
  status         StudySessionItemStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  studySession   StudySession           @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  card           Card                   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  attempts       CardAttempt[]

  @@unique([studySessionId, position])
  @@index([studySessionId])
  @@index([studySessionId, status])
  @@index([cardId])
}

model CardAttempt {
  id                    String            @id @default(cuid())
  studySessionId        String
  studySessionItemId    String?
  cardId                String
  userAnswer            String?
  recallGrade           RecallGrade
  attemptNumber         Int               @default(1)
  isRetry               Boolean           @default(false)
  gradingMethod         GradingMethod     @default(DETERMINISTIC)
  gradingConfidence     Float?
  semanticScore         Float?
  initialSuggestedGrade RecallGrade?
  refinementApplied     Boolean           @default(false)
  latencyMs             Int?
  createdAt             DateTime          @default(now())
  studySession          StudySession      @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  studySessionItem      StudySessionItem? @relation(fields: [studySessionItemId], references: [id], onDelete: SetNull)
  card                  Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([studySessionId])
  @@index([studySessionItemId])
  @@index([cardId])
  @@index([studySessionId, cardId])
}

// --- Courses ---

model Course {
  id             String            @id @default(cuid())
  userId         String
  title          String
  // Setup answers from the course form
  topic          String
  goal           String
  priorKnowledge String
  timePerWeek    String
  depth          String
  notes          String
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck           Deck?
  proposal       SyllabusProposal?
  lessons        Lesson[]

  @@index([userId, archivedAt])
}

model SyllabusProposal {
  id            String    @id @default(cuid())
  courseId      String    @unique
  // Ordered lessons: [{ title, objectives: string[] }]
  lessons       Json
  model         String
  promptVersion String
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id                  String          @id @default(cuid())
  courseId            String
  title               String
  position            Int
  objectives          String[]
  // Learner state: set when the lesson is first opened with content
  firstOpenedAt       DateTime?
  // Set while a version is being generated, so a concurrent open waits
  generationClaimedAt DateTime?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  course              Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions            LessonVersion[]

  @@index([courseId, position])
}

// One generated rendition of a lesson. It never changes once created; the
// newest is the lesson's current version (ADR-0003).
model LessonVersion {
  id            String            @id @default(cuid())
  lessonId      String
  // Content blocks: [{ heading, paragraphs: string[] }]
  content       Json
  // [{ example, explanation }]
  examples      Json
  summary       String
  model         String
  promptVersion String
  createdAt     DateTime          @default(now())
  lesson        Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  attempts      ExerciseAttempt[]

  @@index([lessonId, createdAt])
}

model Exercise {
  id              String            @id @default(cuid())
  lessonVersionId String
  position        Int
  type            ExerciseType
  prompt          String
  // Short answers and fill-in-the-blanks
  expectedAnswers String[]
  // Free-form explanations
  expectedPoints  String[]
  lessonVersion   LessonVersion     @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  attempts        ExerciseAttempt[]

  @@index([lessonVersionId, position])
}

// Learner state: an answer to an exercise and its evaluation, kept with the
// Lesson Version it was made against (ADR-0003)
model ExerciseAttempt {
  id               String             @id @default(cuid())
  lessonVersionId  String
  exerciseId       String
  answer           String
  evaluation       ExerciseEvaluation
  // Set when the answer was an Accent Mismatch: the accented expected answer
  // it matched, shown to the learner as the correction (ADR-0002)
  accentCorrection String?
  method           EvaluationMethod
  // Set by the database to the microsecond (Prisma's now() is only
  // milliseconds), so attempts made in quick succession keep their order
  createdAt        DateTime           @default(dbgenerated("now()")) @db.Timestamp(6)
  lessonVersion    LessonVersion      @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  exercise         Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
  @@index([lessonVersionId])
}

model AiUsage {
  id           String    @id @default(cuid())
  userId       String
  purpose      AiPurpose
  model        String
  inputTokens  Int
  outputTokens Int
  // The call failed with no response, so the API may still have billed it
  // and the token counts may be a conservative estimate.
  failed       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

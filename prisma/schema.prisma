generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---

enum RecallGrade {
  MISSED
  PARTIALLY_CORRECT
  GOOD
  NAILED
}

enum CardLifecycleState {
  NEW
  LEARNING
  STABLE
  RETIRED
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum StudySessionItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum SessionType {
  QUICK
  STANDARD
  DEEP
}

enum StudyMode {
  STUDY
  DRILL_WEAKEST
  CRAM
}

enum GradingMethod {
  DETERMINISTIC
  SEMANTIC
  LLM
  REFINED_VARIANT
}

enum AiPurpose {
  SYLLABUS_GENERATION
  LESSON_GENERATION
  EXERCISE_EVALUATION
  CARD_PROPOSAL
  CARD_REVISION
  TUTOR
}

// Who wrote a Tutor Thread message
enum TutorRole {
  LEARNER
  TUTOR
}

enum ExerciseType {
  SHORT_ANSWER
  FILL_IN_THE_BLANK
  FREE_FORM_EXPLANATION
}

// PARTIALLY_CORRECT is for free-form explanations only (ADR-0006)
enum ExerciseEvaluation {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
}

enum EvaluationMethod {
  DETERMINISTIC
  LLM
}

// --- Models ---

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  decks         Deck[]
  studySessions StudySession[]
  sessions      Session[]
  cardProgress  CardProgress[]
  courses       Course[]
  aiUsage       AiUsage[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Deck {
  id            String         @id @default(cuid())
  userId        String
  // Set on a Course Deck. The deck outlives its course (ADR-0003).
  courseId      String?        @unique
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cards         Card[]
  studySessions StudySession[]

  @@index([userId])
}

model Card {
  id                  String             @id @default(cuid())
  deckId              String
  front               String
  position            Int                @default(0)
  // Set on a card made from a lesson: the Lesson, not the version, and the
  // model and prompt version that proposed it
  sourceLessonId      String?
  sourceModel         String?
  sourcePromptVersion String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deck                Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  sourceLesson        Lesson?            @relation(fields: [sourceLessonId], references: [id], onDelete: SetNull)
  canonicalAnswers    CanonicalAnswer[]
  versions            CardVersion[]
  attempts            CardAttempt[]
  progress            CardProgress[]
  sessionItems        StudySessionItem[]

  @@index([deckId])
  @@index([deckId, position])
  @@index([sourceLessonId])
}

// What a card asked from `startedAt` (ADR-0008): its front and Canonical
// Answers' texts, primary first, as they were. Its first comes with the card,
// and a new one with each progress reset (ADR-0004); changing Accepted
// Variants never starts one. The latest is the card's current version.
model CardVersion {
  id                  String        @id @default(cuid())
  cardId              String
  number              Int
  front               String
  canonicalAnswers    String[]
  // Once it's over, each Canonical Answer's Accepted Variants as it ended
  // with them, as [{ text, acceptedVariants }]; none for the current version,
  // whose are the card's own, and for versions that ended before they were
  // recorded (#51)
  acceptedVariants    Json?
  // Set on a version a revision of the deck started (ADR-0007): the model
  // and prompt version that proposed the edit
  sourceModel         String?
  sourcePromptVersion String?
  // Set on a version restoring an earlier one (#54): that version's number
  restoredFromNumber  Int?
  startedAt           DateTime      @default(now())
  card                Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  attempts            CardAttempt[]

  @@unique([cardId, number])
}

model CanonicalAnswer {
  id               String            @id @default(cuid())
  cardId           String
  text             String
  normalizedText   String?
  isPrimary        Boolean           @default(false)
  // Order among the card's answers, as the author gave them; the primary first
  position         Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  card             Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  acceptedVariants AcceptedVariant[]

  @@unique([cardId, text])
  @@index([cardId])
}

model AcceptedVariant {
  id                String          @id @default(cuid())
  canonicalAnswerId String
  text              String
  normalizedText    String?
  createdAt         DateTime        @default(now())
  canonicalAnswer   CanonicalAnswer @relation(fields: [canonicalAnswerId], references: [id], onDelete: Cascade)

  @@unique([canonicalAnswerId, text])
  @@index([canonicalAnswerId])
}

model CardProgress {
  id                 String             @id @default(cuid())
  userId             String
  cardId             String
  deckId             String
  lifecycleState     CardLifecycleState @default(NEW)
  masteryScore       Int                @default(0)
  dueAt              DateTime?
  lastReviewedAt     DateTime?
  lastIntervalDays   Float?
  lapseCount         Int                @default(0)
  // When the card last entered its lifecycle state, so LEARNING → STABLE
  // counts only the successes since (#7); none from before it was recorded
  lifecycleChangedAt DateTime?
  // When the learner last marked the card known (ADR-0009), so replaying its
  // answers keeps the mark; none once its progress resets
  markedKnownAt      DateTime?
  // When this progress last started over from NEW: its creation or a card
  // edit reset (ADR-0004). Only attempts since then count toward stats.
  resetAt            DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card               Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, deckId, lifecycleState, dueAt])
  @@index([userId, deckId, lifecycleState, masteryScore])
  @@index([userId, deckId, dueAt])
}

model StudySession {
  id          String             @id @default(cuid())
  userId      String
  deckId      String
  status      StudySessionStatus @default(ACTIVE)
  sessionType SessionType
  studyMode   StudyMode          @default(STUDY)
  startedAt   DateTime           @default(now())
  endedAt     DateTime?
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck        Deck               @relation(fields: [deckId], references: [id], onDelete: Cascade)
  items       StudySessionItem[]
  attempts    CardAttempt[]

  @@index([userId])
  @@index([deckId])
  @@index([userId, deckId, status])
}

model StudySessionItem {
  id             String                 @id @default(cuid())
  studySessionId String
  cardId         String
  position       Int
  status         StudySessionItemStatus @default(PENDING)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  studySession   StudySession           @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  card           Card                   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  attempts       CardAttempt[]

  @@unique([studySessionId, position])
  @@index([studySessionId])
  @@index([studySessionId, status])
  @@index([cardId])
}

model CardAttempt {
  id                    String            @id @default(cuid())
  studySessionId        String
  studySessionItemId    String?
  cardId                String
  // The Card Version answered; none for attempts from before versions were
  // recorded and before the card's last reset (ADR-0008)
  cardVersionId         String?
  userAnswer            String?
  recallGrade           RecallGrade
  attemptNumber         Int               @default(1)
  isRetry               Boolean           @default(false)
  gradingMethod         GradingMethod     @default(DETERMINISTIC)
  gradingConfidence     Float?
  semanticScore         Float?
  initialSuggestedGrade RecallGrade?
  refinementApplied     Boolean           @default(false)
  latencyMs             Int?
  createdAt             DateTime          @default(now())
  studySession          StudySession      @relation(fields: [studySessionId], references: [id], onDelete: Cascade)
  studySessionItem      StudySessionItem? @relation(fields: [studySessionItemId], references: [id], onDelete: SetNull)
  card                  Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardVersion           CardVersion?      @relation(fields: [cardVersionId], references: [id], onDelete: SetNull)

  @@index([studySessionId])
  @@index([studySessionItemId])
  @@index([cardId])
  @@index([cardVersionId])
  @@index([studySessionId, cardId])
}

// --- Courses ---

model Course {
  id             String            @id @default(cuid())
  userId         String
  title          String
  // Setup answers from the course form
  topic          String
  goal           String
  priorKnowledge String
  timePerWeek    String
  depth          String
  notes          String
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck           Deck?
  proposal       SyllabusProposal?
  lessons        Lesson[]

  @@index([userId, archivedAt])
}

model SyllabusProposal {
  id            String    @id @default(cuid())
  courseId      String    @unique
  // Ordered lessons: [{ title, objectives: string[] }]
  lessons       Json
  model         String
  promptVersion String
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id                  String          @id @default(cuid())
  courseId            String
  title               String
  position            Int
  objectives          String[]
  // Learner state: set when the lesson is first opened with content
  firstOpenedAt       DateTime?
  // Learner state: Lesson Completion, set and undone by the learner in any
  // order. Progress through the syllabus, never evidence of mastery
  completedAt         DateTime?
  // Learner state: when the learner last started the lesson over. Only
  // Exercise Attempts since then show on the lesson; earlier ones are kept
  // (ADR-0003). Set from the database clock rounded up to the next
  // millisecond, so it falls after every earlier attempt's microsecond
  // createdAt (nextResetTime)
  resetAt             DateTime?
  // Set while a version is being generated, so a concurrent open waits
  generationClaimedAt DateTime?
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  course              Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions            LessonVersion[]
  cards               Card[]

  @@index([courseId, position])
}

// One generated rendition of a lesson. It never changes once created; the
// newest is the lesson's current version (ADR-0003).
model LessonVersion {
  id            String            @id @default(cuid())
  lessonId      String
  // Content blocks: [{ heading, paragraphs: string[] }]
  content       Json
  // [{ example, explanation }]
  examples      Json
  summary       String
  model         String
  promptVersion String
  createdAt     DateTime          @default(now())
  lesson        Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  attempts      ExerciseAttempt[]
  tutorThread   TutorThread?

  @@index([lessonId, createdAt])
}

model Exercise {
  id                  String            @id @default(cuid())
  lessonVersionId     String
  position            Int
  type                ExerciseType
  prompt              String
  // Short answers and fill-in-the-blanks
  expectedAnswers     String[]
  // Free-form explanations: what the question asks for, and related
  // details that never decide the evaluation (ADR-0006)
  essentialPoints     String[]
  supplementaryPoints String[]
  // Free-form explanations generated before that split: a reference list,
  // not requirements (ADR-0006)
  expectedPoints      String[]
  // An open exercise's answer that matches no expected answer is evaluated
  // by AI; a closed one's is wrong (ADR-0005). Exercises generated before
  // lessons were marked are closed, except free-form explanations
  open                Boolean           @default(false)
  lessonVersion       LessonVersion     @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  attempts            ExerciseAttempt[]

  @@index([lessonVersionId, position])
}

// Learner state: an answer to an exercise and its evaluation, kept with the
// Lesson Version it was made against (ADR-0003)
model ExerciseAttempt {
  id               String             @id @default(cuid())
  lessonVersionId  String
  exerciseId       String
  answer           String
  evaluation       ExerciseEvaluation
  // Set when the answer was an Accent Mismatch: the accented expected answer
  // it matched, shown to the learner as the correction (ADR-0002)
  accentCorrection String?
  method           EvaluationMethod
  // Written feedback from AI evaluation; deterministic checks give none
  feedback         String?
  // The model and prompt version that judged an AI evaluation, so an
  // attempt can be traced to what graded it
  model            String?
  promptVersion    String?
  // A free-form explanation's per-point assessment from the judge, which
  // the evaluation is derived from (ADR-0006)
  assessment       Json?
  // Set by the database to the microsecond (Prisma's now() is only
  // milliseconds), so attempts made in quick succession keep their order.
  // clock_timestamp(), not now(): Prisma reads a now() default back as its
  // own @default(now()) and would see a change in every migration
  createdAt        DateTime           @default(dbgenerated("clock_timestamp()")) @db.Timestamp(6)
  lessonVersion    LessonVersion      @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  exercise         Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt])
  @@index([lessonVersionId])
}

// Learner state: the conversation with the tutor about one Lesson Version.
// A new version starts a fresh thread; the old one stays with its version
model TutorThread {
  id              String         @id @default(cuid())
  lessonVersionId String         @unique
  createdAt       DateTime       @default(now())
  lessonVersion   LessonVersion  @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  messages        TutorMessage[]
}

// One message in a Tutor Thread. A learner's message is stored with the
// tutor's reply once the reply is complete, so the thread never holds a
// question the tutor didn't answer
model TutorMessage {
  id            String      @id @default(cuid())
  threadId      String
  role          TutorRole
  content       String
  // The model and prompt version that wrote a tutor reply
  model         String?
  promptVersion String?
  createdAt     DateTime    @default(now())
  thread        TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AiUsage {
  id                 String    @id @default(cuid())
  userId             String
  purpose            AiPurpose
  model              String
  // Input tokens neither written to nor read from the prompt cache
  inputTokens        Int
  // Input tokens written to the 5-minute and 1-hour prompt cache, and read
  // from it, each priced at its own rate
  cacheWrite5mTokens Int       @default(0)
  cacheWrite1hTokens Int       @default(0)
  cacheReadTokens    Int       @default(0)
  outputTokens       Int
  // The call failed with no response, so the API may still have billed it
  // and the token counts may be a conservative estimate.
  failed             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}
